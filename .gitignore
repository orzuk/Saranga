__pycache__/
*.pyc

# Local runtime output from run_pipeline.py / SLURM jobs
output/
smoke_test_out/
logs/

# gold_paper_output/: keep JSONs + PNGs + HTMLs (the visual artifacts);
# skip regenerable reports and SVGs (redundant with PNGs)
gold_paper_output/anomalies_*
gold_paper_output/corpus_stats.csv
gold_paper_output/validate_report.csv
gold_paper_output/json/*.svg

# Downloaded textbook corpus (raw PDFs, LaTeX sources, extracted text, logs)
# — never commit; regenerable from scripts and external PDFs
textbooks/pdf/
textbooks/pdf_quarantine/
textbooks/source/
textbooks/extracted/
textbooks/*.log
textbooks/*.json
textbooks/extraction_run_*.log
textbooks/*.md

# Ad-hoc package tarballs
alignment_benchmark_for_yaron/
alignment_benchmark_for_yaron.tar.gz

# Cluster-staging textbook data (raw PDFs / extracted text — too large)
textbooks_cluster_staging/

# Portal runtime cache (regenerable)
portal/cache/

# Tier2 bulk corpus (canonical on HuggingFace dataset RHCPP/saranga;
# locally mirrored at $SARANGA_DATA_ROOT/tier2, exposed under
# portal/data/tier2 via junction).
portal/data/tier2/

# Claude Code local settings (not for shared repo)
.claude/

# Editor / OS cruft
.DS_Store
*.swp
*~

# Secrets — never commit API keys
.env
