{
 "rules": [
  {
   "uid": 1,
   "name": "denote_definition_cue",
   "type": "definition",
   "regex": "^(?!.*\\b(?:where|recall|to denote|which denotes|that denotes)\\b).*\\b(?:denote|denotes|denoted)\\b",
   "flags": "i",
   "span": "1",
   "precision": 0.7347
  },
  {
   "uid": 2,
   "name": "let_introduces_object",
   "type": "definition",
   "regex": "^\\s*(?:\\\\noindent\\s*)?Let\\b(?![^;]*?\\\\(?:[cC]|eq)?ref\\b)(?:(?![^;]*?\\bbe\\b)[^;]*?(?:[=<>]|\\\\in\\b|\\\\coloneqq|\\\\stackrel|\\b(?:represent|denotes?|defines?|stand)\\b)|(?!\\s+(?:us|me)\\b)[^.;]*?\\bbe\\s+(?:(?:an?|the|two|fixed|defined|called|given|any|some)\\b|\\$))",
   "flags": "i",
   "span": "1",
   "precision": 0.5734
  },
  {
   "uid": 3,
   "name": "we_assume_main_clause",
   "type": "assumption",
   "regex": "(?:(?<!since[\\s~])(?<!because[\\s~])(?<!if[\\s~])\\bwe\\s+(?:(?:also|can|will|shall|do|now|here|still|simply|then)\\s+)*assume\\b)|(?:^\\s*(?:\\\\noindent\\s+)?(?:also\\s+)?assume\\b)",
   "flags": "i",
   "span": "1",
   "precision": 0.5347
  },
  {
   "uid": 5,
   "name": "it_is_cue_claim_broad",
   "type": "claim",
   "regex": "^\\s*(?:\\\\noindent\\s*)?It\\s+(?:is|was)\\s+(?:(?:now|also|quite|very|fairly|still|really|simply|readily|easily|well|not|and|too|further|rather|so|the)\\s+|[\\w-]+\\s+)?(?:known|well-known|easy|easily|clear|obvious|obviously|straightforward|immediate|readily|hard|difficult|simple|remarkable|interesting|important|verified|seen|possible|noted|worth|shown|standard|routine|natural|trivial|elementary|direct|checked|proved|proven|observed)\\b.*?(?:\\bthat\\b|\\bif\\b|\\bfrom\\b|,|:)",
   "flags": "i",
   "span": "1",
   "precision": 0.4801
  },
  {
   "uid": 7,
   "name": "is_defined_by_as_cue",
   "type": "definition",
   "regex": "\\bdefined[\\s~]+(?:by|as|inductively|analogously|respectively)\\b(?![\\s~]+(?:\\\\eqref|\\\\ref|Eq|Equation|Proposition|Definition|follows|the\\s+equations))",
   "flags": "i",
   "span": "1",
   "precision": 0.5207
  },
  {
   "uid": 9,
   "name": "theorem_ref_implies_claim",
   "type": "claim",
   "regex": "\\b(?:Theorem|Thm\\.?)s?~?\\s*\\\\c?ref\\{[^}]*\\}(?:\\\\,|\\s|\\([^)]*\\)|,\\s*)*(?:(?:then|physically|also|still|just|indeed|now|always|again)\\s+)*(?:implies|extends|holds\\b(?!\\s+(?:for|with))|yields|can\\s+(?:lead|give|yield)|establishes\\s+not\\s+only|provides\\s+(?:a|an)\\s+(?:direct|new|simple|explicit|quantitative|sharp|improved)\\b)",
   "flags": "i",
   "span": "1",
   "precision": 0.7567
  },
  {
   "uid": 10,
   "name": "we_or_one_define_as_definition",
   "type": "definition",
   "regex": "\\b(?:[Ww]e\\s+(?!(?:have|has|had)\\b)(?:[A-Za-z]+\\s+){0,2}?|[Oo]ne\\s+(?!(?:can|could|may|might|have|has|had)\\b)(?:[A-Za-z]+\\s+){0,2}?)[Dd]efine[sd]?\\b.{0,200}?\\b(?:as|if|said|called|to be)\\b",
   "flags": "s",
   "span": "1",
   "precision": 0.5667
  },
  {
   "uid": 11,
   "name": "author_showed_proved_that",
   "type": "theorem",
   "regex": "^(?!(?:In|Moreover|As|We|The|It|This|However|Indeed|Regarding|Finally|Here|Then|Also|A|An|Both|Extending|Due|Still|Now|Thus|Hence)\\b)[^.]{0,120}?\\b(?:showed|proved)(?:\\s+in\\s+\\\\cite\\{[^}]*\\})?\\s+(?:that|if|for)\\b",
   "flags": "",
   "span": "1",
   "precision": 0.7684
  },
  {
   "uid": 12,
   "name": "we_write_or_define_cue",
   "type": "definition",
   "regex": "(?!.*\\b(?:instead\\s+of|stop\\s+writing|which\\s+we\\s+write|to\\s+denote|recall|respectively)\\b)(?!.*\\\\begin\\{(?:align|eqnarray))\\bwe\\s+(?:now\\s+)?(?:write\\b[^.]*?\\b(?:for|as|whenever|if|when)\\b|write(?=\\s*(?:\\$|\\\\\\(|\\\\\\[|\\\\begin|\\\\emph|\\\\textit|\\\\textbf))|define\\s+(?:the|a|an)\\b|say\\b)",
   "flags": "is",
   "span": "1",
   "precision": 0.5975
  },
  {
   "uid": 13,
   "name": "cited_theorem_with_source_cue",
   "type": "theorem",
   "regex": "(?:follows?\\s+from|according\\s+to|proved\\s+in|results?\\s+of|see\\s+for\\s+example|satisfies|is\\s+shown\\s+(?:in|by)|^\\s*(?:From|By)|\\(\\s*cf\\.?|\\()\\s*~?\\s*\\{?\\s*\\\\cite\\[\\s*Theorem",
   "flags": "i",
   "span": "1",
   "precision": 0.73
  },
  {
   "uid": 14,
   "name": "emphasised_term_with_definitional_cue",
   "type": "definition",
   "regex": "^(?=.*(?:\\\\emph\\{|\\\\textit\\{|\\\\textbf\\{|\\{\\\\em\\b|\\{\\\\it\\b|\\\\it\\b))(?=.*(?:denot|\\bcall|we say|\\bis an? |\\bare an? |termed|refer|written|known as|defin)).*",
   "flags": "is",
   "span": "1",
   "precision": 0.5586
  },
  {
   "uid": 15,
   "name": "it_follows_claim_opening",
   "type": "claim",
   "regex": "^\\s*(?:(?:Moreover|Then|Furthermore|Also)\\s*,?\\s+|More precisely,\\s*|(?:Since|From)\\s[^,]*,\\s*)?it follows\\s+(?:from|that|easily|immediately|also)\\b",
   "flags": "i",
   "span": "1",
   "precision": 0.6244
  },
  {
   "uid": 16,
   "name": "proof_cue_broadened",
   "type": "proof",
   "regex": "\\b(?:can (?:also )?be (?:easily )?checked|(?:same|similar) (?:proof|line) as|proceeding as in|following the same|as follows from|the following [^.]*?follows? (?:from|by)|this follows (?:immediately |directly )?(?:from|by)|(?:is|are) (?:a |an )?(?:direct |immediate |simple )?consequences? of|we (?:immediately |easily |directly )?(?:get|obtain|deduce|derive) the following|the proof (?:repeats|is (?:almost )?(?:identical|analogous|similar|the same))|(?:in the proof of|as in the proof of|as in)\\s+(?:the\\s+)?(?:lemma|proposition|corollary)s?~?\\s*\\\\ref\\{|(?:with|by|via|from)\\s+(?:the\\s+)?(?:lemma|proposition|corollary)s?~?\\s*\\\\ref\\{[^}]*\\}(?!\\s*,))",
   "flags": "i",
   "span": "para",
   "precision": 0.563
  },
  {
   "uid": 17,
   "name": "in_the_notation_definition_tight",
   "type": "definition",
   "regex": "^\\s*\\(?In the\\b.*?\\b(?:will (?:simply )?(?:represent|denote)|denote|represent|we (?:also )?(?:simply )?write|we can define|let\\b.*?\\bbe\\b|is called|we say|is defined|the mean)\\b",
   "flags": "i",
   "span": "1",
   "precision": 0.7214
  },
  {
   "uid": 18,
   "name": "consider_definition_broad",
   "type": "definition",
   "regex": "^\\s*(?:\\\\item\\s+)?Consider\\s+(?:also\\s+|then\\s+)?(?!.*(?:as defined|as usual|from\\s*\\(|where we|in which|which generates|as before|as seen|endowed with|without loss|for the moment|for simplicity|for now))(?:for\\s+|(?:the|a|an|another)\\s+(?!(?:following|case|situation|fact|claim|simple|identity|projection|category|city|two|any|problem|round|event|setting|algorithm|extreme|standard|example)\\b)|\\$)",
   "flags": "i",
   "span": "1",
   "precision": 0.5875
  },
  {
   "uid": 19,
   "name": "if_we_set_write_definition",
   "type": "definition",
   "regex": "^\\s*If\\b.*\\b(?:we|one|I)\\s+(?:(?:shall|will|may|can|also|then)\\s+)*(?:set|write|let|say|define|denote|consider)\\b|^\\s*If\\b.*\\b(?:is|are)\\s+called\\b",
   "flags": "is",
   "span": "1",
   "precision": 0.7
  },
  {
   "uid": 20,
   "name": "recall_definition_single_cue",
   "type": "definition",
   "regex": "(?:(?!.*\\b(?:called|said\\s+to\\s+be)\\b.*\\b(?:called|said\\s+to\\s+be)\\b)\\brecall\\s+(?:that\\s+)?(?:an?\\s+|the\\s+)?[^.]*?\\b(?:is|are)\\s+(?:called|said\\s+to\\s+be|defined\\s+as|the\\s+universal)\\b)|(?:\\brecall\\s+that\\s+we\\s+set\\b.*?\\bto\\s+be\\b)|(?:^\\W*recall\\s+the\\s+definition\\b(?!.*?(?:\\\\c?ref|\\\\eqref|\\bfrom\\b|\\bDefinition\\b))(?!.*;\\s*\\$\\$))",
   "flags": "i",
   "span": "1",
   "precision": 1.0
  },
  {
   "uid": 21,
   "name": "for_clause_definition_broad",
   "type": "definition",
   "regex": "^\\s*For\\s+(?!(?:the|that|this|these|instance|now|our|each|example|simplicity|sake)\\b)(?!\\w+\\s+reason\\b).{0,400}?(?:\\b(?:let|define|defines|denote|denotes|denoting|denoted|write|introduce|represents?|stands\\s+for|refers\\s+to)\\b|\\bwe\\s+(?:say|note|write)\\b|\\bis\\s+given\\s+by\\b|\\bis\\s+(?:called|said)\\b|\\\\(?:emph|emphd|em|textit|textbf)\\b|\\bset(?=\\s+[$\\\\]))",
   "flags": "is",
   "span": "1",
   "precision": 0.7562
  },
  {
   "uid": 22,
   "name": "proof_opening_tight",
   "type": "proof",
   "regex": "^\\s*(?:\\\\label\\{[^}]*\\}\\s*|\\\\underbar\\s*\\{\\s*)*(?!.*\\b(?:relies|resides|relegate[sd]?|provided|included|appears|exploit|removes|takes|reveals|presented|has\\s+been|have\\s+been|can\\s+be|is\\s+(?:given|included)|is\\s+(?:quite\\s+|technically\\s+)?(?:technical\\w*|demanding))\\b)(?:(?:(?:The|A|An|Also\\s+the|For\\s+the|For)\\s+)?(?:(?:simple|standard|direct|short|detailed|complete|full|alternative|quick)\\s+)?[Pp]roof\\s*(?:,|of\\b(?!\\s+a\\b)|for\\b|follows|goes|essentially|is\\s+(?:entirely\\s+|essentially\\s+|completely\\s+)?(?:based|done|similar|given|straightforward))|(?:Let\\s+us|We\\s+(?:now\\s+|will\\s+|first\\s+)?(?:start|begin))\\b.*\\bproof\\b|The\\s+(?:rest|remainder)\\s+of\\s+(?:this|the)\\s+\\w+\\s+(?:is\\s+)?(?:therefore\\s+|thus\\s+)?(?:devoted|dedicated)\\s+to\\s+the\\s+proof\\b)",
   "flags": "i",
   "span": "para",
   "precision": 0.6443
  },
  {
   "uid": 24,
   "name": "open_question_broad_if_whether",
   "type": "open_problem",
   "regex": "(?:\\b(?:is|was|remains|are|were|be|being)\\s+(?:currently\\s+|still\\s+|then\\s+)?(?:an?\\s+|the\\s+)?(?:\\w+\\s+)?open\\s+(?:question|problem)\\b|^\\s*(?:the|an?|one)\\s+(?:\\w+\\s+)?open\\s+(?:question|problem)\\b|\\bthe\\s+open\\s+question\\s+of\\b|\\b(?:raised|posed|asked|raise|pose|ask|raises|poses|asks)\\s+(?:the|an?|this)\\s+(?:\\w+\\s+)?question\\b|\\bopen\\s+question\\s+(?:of|whether|as)\\b|(?<!address the )(?<!study the )(?<!answer the )(?<!consider the )(?<!investigate the )\\bquestion\\s+whether\\b|\\bquestion\\b[^.]{0,200}?\\bis\\s+(?:still\\s+)?open\\b|\\bquestion\\b[^.]{0,200}?\\bof\\s+(?:great|considerable|particular|central|major|practical|the\\s+utmost|interest|importance)\\b|\\bof\\s+interest\\b[^.]{0,60}?\\bquestion\\b|\\b(?:research|related|further|another|following|additional)\\s+question\\b|\\b(?:answer|address|study|resolve|settle)\\s+the\\s+question\\s*:|\\{\\s*(?:\\\\bf|\\\\textbf\\{)\\s*question\\s*:|\\bquestion\\s+that\\s+arises?\\b|^\\s*the\\s+question\\s+(?:is|was)\\s+(?:if|whether)\\b|\\b(?:interesting|natural|open|important|intriguing|fundamental|difficult|challenging|basic)\\s+question\\s+(?:if|whether)\\b)",
   "flags": "i",
   "span": "1",
   "precision": 0.7732
  },
  {
   "uid": 25,
   "name": "definition_cue_tight",
   "type": "definition",
   "regex": "(?:\\bdenotes?\\b|\\bdenoted\\b(?!\\s+as\\b)|\\bis (?:called|defined|denoted)\\b|\\bwe (?:also )?define\\b|\\bwe say (?:that )?\\S+ is\\b|^\\s*(?:the|a|an)\\s+\\\\emph\\{)",
   "flags": "i",
   "span": "1",
   "precision": 0.6536
  },
  {
   "uid": 26,
   "name": "it_is_known_that_result",
   "type": "theorem",
   "regex": "^\\s*It is (?:fairly easy to show|well[- ]?known|known)(?: by [^.]*?)? that\\s+(?!(?:this|all|when|it)\\b)",
   "flags": "i",
   "span": "1",
   "precision": 0.7865
  },
  {
   "uid": 27,
   "name": "for_each_where_or_define_definition",
   "type": "definition",
   "regex": "^\\s*For each\\b.*?(?:\\bwhere\\b|\\bdefine[sd]?\\b|:=)",
   "flags": "is",
   "span": "1",
   "precision": 1.0
  },
  {
   "uid": 28,
   "name": "conjecture_cue_phrase",
   "type": "conjecture",
   "regex": "\\bconjectured\\s+(that|to\\s+be)\\b|(?<!\\bsuggested the )(?<!\\bproposed the )\\bconjectures?\\s+that\\b|\\bconjecture\\b[^.]{0,80}\\b(states|asserts|asserting|stating)\\b",
   "flags": "i",
   "span": "1",
   "precision": 0.8565
  },
  {
   "uid": 30,
   "name": "we_see_claim_broad",
   "type": "claim",
   "regex": "^\\s*We see(?:\\s+(?:that|such|large))?\\b(?!.*(?:\\$\\$|\\bit\\s+is\\b|\\bgiven\\b|\\bthree\\b|\\binvolves\\b|\\bprovides\\s+both\\b))",
   "flags": "i",
   "span": "1",
   "precision": 0.5526
  },
  {
   "uid": 31,
   "name": "given_emphasised_term_definition",
   "type": "definition",
   "regex": "^\\s*Given\\s+(?!that\\b)(?=.*(?:\\\\emph\\{|\\\\textit\\{|\\\\textbf\\{|\\{\\\\em\\b|\\{\\\\it\\b)).*\\b(?:is|if|produces|denotes|means)\\b",
   "flags": "i",
   "span": "1",
   "precision": 1.0
  },
  {
   "uid": 32,
   "name": "let_be_the_definition",
   "type": "definition",
   "regex": "^\\s*(\\\\item\\s*)?Let\\b.*?\\bbe\\s+the\\b",
   "flags": "is",
   "span": "1",
   "precision": 0.6516
  },
  {
   "uid": 33,
   "name": "proof_start_assumption_cue",
   "type": "proof",
   "regex": "(?:\\b(?:let\\s+us|let\\s+me)\\s+assume\\b|^\\s*assume\\b|\\bassume\\s+for\\s+contradiction\\b|\\bargue\\s+by\\s+contradiction\\b|\\bby\\s+assuming\\b)",
   "flags": "i",
   "span": "para",
   "precision": 0.3246
  },
  {
   "uid": 34,
   "name": "known_result_with_citation_that",
   "type": "theorem",
   "regex": "^It is (?:well[- ]?known|well know|known|proved|proven|shown)\\b[^.]{0,80}?(?:\\bsince\\b|\\\\cite|\\[[A-Za-z]|\\([A-Z][^)]*\\d{4}\\))[^.]{0,80}?\\bthat\\b",
   "flags": "i",
   "span": "1",
   "precision": 0.71
  },
  {
   "uid": 35,
   "name": "note_that_definition_broad",
   "type": "definition",
   "regex": "^(?!.*(?:\\\\cite|\\\\eqref|\\\\ref\\b|\\\\footnote|\\bwell-known\\b|\\bknown as\\b|\\talthough\\b|\\bbecause\\b|\\bsince\\b|\\bcase\\b|\\bassumption\\b))(?!\\s*(?:\\\\textbf\\{)?\\s*define\\b)(?=.*\\bnote\\b)(?=.*(?::=|\\{\\\\bf\\b|\\bis (?:called|termed|defined|denoted|introduced|given)\\b|\\bcall(?:ed)?\\b|\\bterm(?:ed)?\\b|\\bdenote[ds]?\\b|\\bmeaning\\b|\\bunderstood\\b|\\babbreviation\\b|\\bintroduced\\b|\\bwe say\\b|\\bdefined by\\b|\\bstands? for\\b|\\bexpress\\b.*\\bas\\b|\\bnote that often\\b|\\bnote that we have\\s*\\\\begin\\{equation)).*",
   "flags": "i",
   "span": "1",
   "precision": 0.6923
  },
  {
   "uid": 36,
   "name": "theorem_cited_result_verb",
   "type": "theorem",
   "regex": "^(?!\\s*(\\(|We\\b|The following|\\\\noindent|\\\\ifLongCites|Whereas|In\\s+(a|related|particular)\\b|In\\s+\\\\cite(\\[[^\\]]*\\])?\\{[^}]*\\}\\s*,))(?!.*(see also|\\\\newtheorem|\\\\ifLongCites)).*?(\\\\cite(\\[[^\\]]*\\])?\\{[^}]*\\}[^.]*?\\b(proved|shown|showed|shows|disproved|verified|established|confirmed|refuted)\\b|\\b(proved|disproved|verified|established|confirmed|refuted|shown|showed|shows)\\b[^.]*\\\\cite|\\bTheorem~?\\d)",
   "flags": "i",
   "span": "1",
   "precision": 0.5608
  },
  {
   "uid": 37,
   "name": "theorem_attribution_tight",
   "type": "theorem",
   "regex": "(\\btheorem\\s+of\\s+[^.]*?\\s(which\\s+)?(states|says|gives|shows)\\b|\\bfolk\\s+theorem\\b|\\btheorem\\s+(says|states|translates)\\b|\\bTheorem\\s+\\d[\\d.]*\\s+(states|says|shows)\\b|^\\s*Theorem\\s+\\d[\\d.]*\\s+(in|of)\\s+\\S+\\s+(gives|shows|provides|establishes)\\b|\\(\\s*see\\s+Theorem\\s+\\d+\\s+(in|of)\\b|\\[Theorem\\s+\\d[\\d.]*\\]\\{[^}]*\\}\\s+also\\s+(says|states)\\b)",
   "flags": "i",
   "span": "1",
   "precision": 0.8308
  },
  {
   "uid": 38,
   "name": "we_shall_assume_broad",
   "type": "assumption",
   "regex": "\\bwe\\s+(?!may\\s+and\\s+will\\s+also\\b)(?:may\\s+and\\s+)?(?:shall|will)\\s+(?:[a-z]+,?\\s+){0,3}?(?:\\{?\\\\(?:emph|textit|em|textbf)\\b\\s*\\{?)?assume\\b",
   "flags": "i",
   "span": "1",
   "precision": 0.5696
  },
  {
   "uid": 39,
   "name": "define_or_fix_using_theorem_opener",
   "type": "definition",
   "regex": "^\\s*(?:Define\\b|(?:Fix|Using|Following)\\b[^.]{0,80}?\\bTheorem\\b|By\\s+\\\\cite\\[Theorem\\b)",
   "flags": "",
   "span": "1",
   "precision": 0.5347
  },
  {
   "uid": 40,
   "name": "we_claim_that_opening",
   "type": "claim",
   "regex": "^\\s*(?:\\\\vskip\\s+\\S+\\s*)?(?:(?:Next|Now|Finally|Then|And)\\s+)?we\\s+claim(?!\\s+now\\b)(?:\\s*:\\s*(?=\\S)|\\s+that\\s+(?!(?:one|if|the|we\\s+have)\\b)(?=\\S))",
   "flags": "i",
   "span": "1",
   "precision": 0.8591
  },
  {
   "uid": 41,
   "name": "we_consider_definition_cue",
   "type": "definition",
   "regex": "^\\s*(?:\\\\noindent\\s*)?We consider\\b.*?(?::=|\\\\coloneqq|\\bdefined\\s+(?:for|by|as)\\b|\\\\emph\\{|\\\\textbf\\{|\\bcalled\\b)",
   "flags": "is",
   "span": "1",
   "precision": 1.0
  },
  {
   "uid": 42,
   "name": "we_will_definitional_cue",
   "type": "definition",
   "regex": "^\\s*(\\\\noindent\\s*)?We will .*?(\\bdefined\\b|\\bnotation\\b|\\bconvention\\b|\\brefer to\\b|\\bdenote\\b|\\bcalled\\b|\\\\emph\\{)",
   "flags": "i",
   "span": "1",
   "precision": 0.6591
  },
  {
   "uid": 43,
   "name": "it_is_easy_verification_cue",
   "type": "proof",
   "regex": "^\\s*It is\\s+(?:(?:readily|easily|clearly|trivially|immediately|directly)\\s+)?(?:seen|verified|clear|obvious|evident|easy|enough|straightforward|routine|simple)\\b",
   "flags": "i",
   "span": "para",
   "precision": 0.2981
  },
  {
   "uid": 44,
   "name": "emphasised_term_definition_cue",
   "type": "definition",
   "regex": "^\\s*In the\\s+(\\\\emph\\{|\\{\\\\em\\s)|(\\\\emph\\{|\\{\\\\em\\s)[^}]*\\}[^.]*\\bwe\\s+(will\\s+)?(mean|say|speak|call)\\b|\\bwe\\s+(will\\s+)?(mean|say|speak|call)\\b[^.]*(\\\\emph\\{|\\{\\\\em\\s)",
   "flags": "i",
   "span": "1",
   "precision": 0.7611
  },
  {
   "uid": 45,
   "name": "from_it_is_noted_claim",
   "type": "claim",
   "regex": "^\\s*From\\b.*?(\\bit\\s+(is|can\\s+be)\\s+(also\\s+)?(noted|observed|immediate|seen)\\b|\\bwe\\s+deduce\\b|\\bis\\s+(also\\s+)?equivalent\\b)",
   "flags": "i",
   "span": "1",
   "precision": 0.7214
  },
  {
   "uid": 46,
   "name": "the_set_of_display_math_is_predicate",
   "type": "definition",
   "regex": "(?:^\\s*\\(?The set (?:of(?! all\\b)|\\$[^$]*\\$\\s*(?:of\\b|:=|=))[^.]*?\\b(?:(?:is|are)\\s+(?:(?:partially\\s+)?(?:ordered|denoted|known|called|defined|written|given|said)\\b|\\$|\\\\\\[|\\\\\\()|forms?\\s+the\\s+\\w+\\s*\\\\\\[|equals?\\s+(?:to\\s+)?the\\b))|(?:^\\s*\\(?The set\\s+(?:\\$\\$|\\\\\\[)[\\s\\S]*?(?:\\$\\$|\\\\\\])[^.]*?\\b(?:is|are)\\s+\\w+)",
   "flags": "i",
   "span": "1",
   "precision": 0.8333
  },
  {
   "uid": 47,
   "name": "the_symbol_definition_cue",
   "type": "definition",
   "regex": "^\\s*The\\s+\\$[^$]*\\$.*?(means that|\\\\stackrel\\{|\\bis called\\b|\\bare called\\b|in symbols|\\bwhere\\b|\\blet\\b|\\bcomprises\\b)",
   "flags": "i",
   "span": "1",
   "precision": 1.0
  },
  {
   "uid": 48,
