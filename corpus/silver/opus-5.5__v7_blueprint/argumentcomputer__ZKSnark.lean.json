  {
   "id": "DP1",
   "type": "definition",
   "name": "Polynomial t",
   "statement": "Fix a finite field $F$. The polynomial $t \\in F[X]$ is then defined as $t = \\prod_{i = 0}^{m - 1} (X - r_i)$ for $r_i \\in F$ for $0 \\leq i \\leq m-1$ where $m > 0$.",
   "section": "1 Supporting Lemmas",
   "origin": "paper",
   "confidence": 1.0,
   "definiendum": "$t$",
   "statement_short": "t is the monic polynomial vanishing at m points r_0,...,r_{m-1} of a finite field F.",
   "tags": [
    "polynomial"
   ],
   "label": "def:poly_t",
   "display": "Definition",
   "number": "1"
  },
  {
   "id": "LP1",
   "type": "lemma",
   "name": "t is monic of positive degree",
   "statement": "The polynomial $t$ is monic of positive degree $0 < m$.",
   "section": "1 Supporting Lemmas",
   "origin": "paper",
   "confidence": 1.0,
   "assumptions": [
    "Fix a finite field $F$."
   ],
   "conclusions": [
    "The polynomial $t$ is monic of positive degree $0 < m$."
   ],
   "tags": [
    "polynomial"
   ],
   "label": "lem:t_props",
   "display": "Lemma",
   "number": "1"
  },
  {
   "id": "DP2",
   "type": "definition",
   "name": "Statement and witness sequences",
   "statement": "Fix natural numbers $n, l$ with $l < n$, and a sequence $a_s = (a_0, \\ldots, a_{l-1})$ and $a_w = (a_l, \\ldots, a_n)$ (the \\emph{statement} and \\emph{witness}).",
   "section": "2 Knowledge Soundness for BabySNARK",
   "origin": "paper",
   "confidence": 0.85,
   "definiendum": [
    "$n$",
    "$l$",
    "$a_s$",
    "$a_w$",
    "statement",
    "witness"
   ],
   "statement_short": "Fix sizes l<n and split the assignment a into a statement part a_s and a witness part a_w.",
   "tags": [
    "zk_snark"
   ]
  },
  {
   "id": "DP3",
   "type": "definition",
   "name": "Polynomials u_i",
   "statement": "Fix also a collection of polynomials $u_i(X) \\in F[X]$ for $0 \\leq i < n$ split up into the first $l$ denoted $u_s$ and the last $l-n$ denoted $u_w$.",
   "section": "2 Knowledge Soundness for BabySNARK",
   "origin": "paper",
   "confidence": 0.85,
   "definiendum": [
    "$u_i(X)$",
    "$u_s$",
    "$u_w$"
   ],
   "statement_short": "Fix polynomials u_i over F, split into statement part u_s and witness part u_w.",
   "tags": [
    "zk_snark"
   ]
  },
  {
   "id": "DP4",
   "type": "definition",
   "name": "Coefficient strings b, h, v",
   "statement": "Finally, fix strings $(b_0, \\ldots,b_m), (h_0, \\ldots, h_m), (v_0, \\ldots v_m) \\in F^m$ where $m = \\deg t$.",
   "section": "2 Knowledge Soundness for BabySNARK",
   "origin": "paper",
   "confidence": 0.85,
   "definiendum": [
    "$(b_0, \\ldots,b_m)$",
    "$(h_0, \\ldots, h_m)$",
    "$(v_0, \\ldots v_m)$",
    "$m$"
