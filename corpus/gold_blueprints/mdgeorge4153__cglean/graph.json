   "id": "D1",
   "type": "definition",
   "name": null,
   "statement": "Given sets of points $A$ and $B$, the Minkowski sum of $A$ and $B$, written $A \u2295 B$ is the set $\\{a + b \\mid a \u2208 A, b \u2208 B\\}$.",
   "origin": "paper",
   "tags": [],
   "section": "6 Minkowski Sum",
   "label": "def:minkowski",
   "lean_names": []
  },
