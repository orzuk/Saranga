   "id": "L1",
   "type": "lemma",
   "name": null,
   "statement": "If $A$ is a field and $n$ is not a square in $A$, then $A[\\sqrt{n}]$ is a field.",
   "origin": "paper",
   "tags": [
    "leanok",
