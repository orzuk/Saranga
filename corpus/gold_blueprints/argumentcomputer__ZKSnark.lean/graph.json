 "nodes": [
  {
   "id": "D1",
   "type": "definition",
   "name": null,
   "statement": "Fix a finite field $F$. The polynomial $t \\in F[X]$ is then defined as $t = \\prod_{i = 0}^{m - 1} (X - r_i)$ for $r_i \\in F$ for $0 \\leq i \\leq m-1$ where $m > 0$.",
   "origin": "paper",
   "tags": [
    "leanok"
   ],
   "section": "2 Supporting Lemmas",
   "label": "def:poly_t",
   "lean_names": []
  },
  {
   "id": "L1",
   "type": "lemma",
   "name": null,
   "statement": "The polynomial $t$ is monic of positive degree $0 < m$.",
   "origin": "paper",
   "tags": [
    "leanok"
   ],
   "section": "2 Supporting Lemmas",
   "label": "lem:t_props",
   "lean_names": []
  },
  {
   "id": "PR_L1",
   "type": "proof",
   "name": null,
   "statement": "",
   "origin": "paper",
   "tags": [
    "leanok"
   ],
   "section": "2 Supporting Lemmas",
   "label": null,
   "proves": [
    "L1"
   ]
  },
  {
   "id": "D2",
   "type": "definition",
   "name": null,
   "statement": "Define the polynomials $V_s = \\sum_i^{n-1} a_i u_i(X) = V_{ss} + V_{sw}$, and \\[ B_w = \\sum_{i = 0}^{m - 1} b_i X^i + b_{\\gamma}Z + b_{\\gamma \\beta}YZ + \\sum_{i = l}^{n - 1} b'_{i} Y u_{i}(X) \\] \\[ V_w = \\sum_{i = 0}^{m - 1} v_i X^i + v_{\\gamma}Z + v_{\\gamma \\beta}YZ + \\sum_{i = l}^{n - 1} v'_{i} Y u_{i}(X) \\] \\[ H = \\sum_{i = 0}^{m - 1} h_i X^i + h_{\\gamma}Z + h_{\\gamma \\beta}YZ + \\sum_{i = l}^{n - 1} h'_{i} Y u_{i}(X) \\]",
   "origin": "paper",
   "tags": [
    "leanok"
   ],
   "section": "3 Knowledge Soundness for BabySNARK",
   "label": "def:V_B_H",
   "lean_names": []
  },
  {
   "id": "D3",
   "type": "definition",
   "name": null,
   "statement": "Call a sequence $(a_i)_{i=0}^{n-1}$ \\emph{satisfying} if \\[ \\sum_{i = 0}^{l - 1} a_i u_i(X) + \\sum_{i = l}^{n - 1} a_i u_i (X) \\equiv 1 \\mod t \\]",
   "origin": "paper",
   "tags": [
    "leanok"
   ],
   "section": "3 Knowledge Soundness for BabySNARK",
   "label": "def:satisfying",
   "lean_names": []
  },
  {
   "id": "L2",
   "type": "lemma",
   "name": null,
   "statement": "$\\forall 0 \\le i < m$, the coefficient of $X^{i}$ in $B_{w}$ (or \\texttt{B\\_wit}) is $b_i$.",
   "origin": "paper",
   "tags": [
    "leanok"
   ],
   "section": "3 Knowledge Soundness for BabySNARK",
   "label": "lem:B_coeff",
   "lean_names": []
  },
  {
   "id": "PR_L2",
   "type": "proof",
   "name": null,
   "statement": "",
   "origin": "paper",
   "tags": [
    "leanok"
   ],
   "section": "3 Knowledge Soundness for BabySNARK",
   "label": null,
   "proves": [
    "L2"
   ]
  },
  {
   "id": "L3",
   "type": "lemma",
   "name": null,
   "statement": "The coefficient of $Z^2$ in $H t + 1$ is 0.",
   "origin": "paper",
   "tags": [
    "leanok"
   ],
   "section": "3 Knowledge Soundness for BabySNARK",
   "label": "lem:Z2_Ht_coeff",
   "lean_names": []
  },
  {
   "id": "L4",
   "type": "lemma",
   "name": null,
   "statement": "Given $(a_i)_{i = 0}^{l - 1}$, the coefficient of $Z^2$ in $(b_{\\gamma \\beta} \\cdot Z + \\sum_{i = 0}^{l - 1} a_i u_i (X) + \\sum_{j = l}^{n - 1} b'_i u_i (X))^2$ is $b_{\\gamma \\beta}^2$.",
   "origin": "paper",
   "tags": [
    "leanok"
   ],
   "section": "3 Knowledge Soundness for BabySNARK",
   "label": "lem:B_sq_coeff",
   "lean_names": []
  },
  {
   "id": "L5",
   "type": "lemma",
   "name": null,
   "statement": "Then given a monomial $m$ not having a $Y$-term, the coefficient of $m$ in $B_w$ is 0.",
   "origin": "paper",
   "tags": [
    "leanok"
   ],
   "section": "3 Knowledge Soundness for BabySNARK",
   "label": "lem:B_Y_coeff",
   "lean_names": []
  },
