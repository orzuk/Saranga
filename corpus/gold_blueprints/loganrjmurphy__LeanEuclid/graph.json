  {
   "id": "P6",
   "type": "proposition",
   "name": null,
   "statement": "$\\triangle~ABC$ and $\\triangle~DEF$ are two triangles with $|AB| = |DE|$, $|AC| = |DF|$, and $\\angle~BAC = \\angle~EDF$. Then, $\\triangle~ABC$ and $\\triangle~DEF$ must be congruent. That is, $|BC| = |EF|$, $\\angle~ABC = \\angle~DEF$, and $\\angle~ACB = \\angle~DFE$.",
   "origin": "paper",
   "tags": [
    "leanok",
    "lean"
   ],
   "section": "8.1 Commentary",
   "label": "proposition_4",
