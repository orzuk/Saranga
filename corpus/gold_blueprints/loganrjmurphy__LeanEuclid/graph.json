  {
   "id": "P2",
   "type": "proposition",
   "name": null,
   "statement": "$A$ and $B$ are two disctinct points on a line $AB$. $X$ is a point not on $AB$. Then there must be a point $C$ on the opposite side of $AB$ from $X$, s.t. $\\triangle~ABC$ is an equilateral triangle.",
   "origin": "paper",
   "tags": [
    "leanok",
    "lean"
   ],
   "section": "5.1 Commentary",
