  {
   "id": "P4",
   "type": "proposition",
   "name": null,
   "statement": "$B$ and $C$ are two distinct points on a line $BC$. For any point $A$, there must be a point $L$, s.t. $|AL| = |BC|$.",
   "origin": "paper",
