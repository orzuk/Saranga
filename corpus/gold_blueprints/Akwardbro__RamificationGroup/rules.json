gor": null, "assumptions": ["If sigmainGal(L/K) lies in the decomposition group of L/K"], "conclusions": ["then \\[i_L/K(sigma) = inftyiff s = 1.\\]"], "raw_latex": "\n    \\label{lowerIndex_eq_top_iff_eq_refl}\n    \n    \n    \n    If $\\sigma\\in\\mathrm{Gal}(L/K)$ lies in the decomposition group of $L/K$, then \\[i_{L/K}(\\sigma) = \\infty\\iff s = 1.\\]\n", "clean_text": "If sigmainGal(L/K) lies in the decomposition group of L/K, then \\[i_L/K(sigma) = inftyiff s = 1.\\]", "label": "lowerIndex_eq_top_iff_eq_refl", "env_name": "theorem", "index": 2}, {"id": "E3", "type": "equation", "name": null, "statement": "i_L/K(sigma) = inftyiff s = 1.", "origin": "paper", "tags": [], "subclass": null, "rigor": null, "raw_latex": "\\[i_{L/K}(\\sigma) = \\infty\\iff s = 1.\\]", "clean_text": "i_L/K(sigma) = inftyiff s = 1.", "env_name": "bracket", "index": 3}, {"id": "R1", "type": "proof", "name": null, "statement": "\n    \n    \n", "origin": "paper", "tags": [], "subclass": null, "rigor": null, "proves": "T2", "raw_latex": "\n    \n    \n", "clean_text": "", "index": 1}, {"id": "T3", "type": "theorem", "name": null, "statement": "The lower ramification groups Gal(L/K)_u vanish for uinZ large enough.", "origin": "paper", "tags": [], "subclass": null, "rigor": null, "assumptions": [], "conclusions": ["The lower ramification groups Gal(L/K)_u vanish for uinZ large enough."], "raw_latex": "\n    \\label{exist_lowerRamificationGroup_eq_bot}\n    \n    \n    \n    The lower ramification groups $\\mathrm{Gal}(L/K)_{u}$ vanish for $u\\in\\mathbb{Z}$ large enough. \n", "clean_text": "The lower ramification groups Gal(L/K)_u vanish for uinZ large enough.", "label": "exist_lowerRamificationGroup_eq_bot", "env_name": "theorem", "index": 3}], "edges": [{"source": "R1", "target": "T2", "type": "proves", "confidence": 1.0}, {"source": "E1", "target": "D1", "type": "uses", "confidence": 1.0}, {"source": "E2", "target": "D2", "type": "uses", "confidence": 1.0}, {"source": "E3", "target": "