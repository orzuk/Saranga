   "id": "T1",
   "type": "theorem",
   "name": null,
   "statement": "There is no dominant strategy in a first price auction for any `i` and any bid `bi`.",
   "origin": "paper",
   "tags": [
    "leanok",
    "lean"
   ],
   "section": "5 Example",
   "label": "FirstPrice.firstprice_auction_has_no_dominant_strategy",
