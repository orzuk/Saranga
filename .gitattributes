# Machine-generated code, tracked on purpose
# ------------------------------------------
# The distillation algorithm writes distilled_rules.py per structure type and
# per pruning step. These are committed deliberately — they are the record of
# what the extractor actually ran, and the snapshots capture the distillation
# trajectory — but they are OUTPUT, not source.
#
# 171 of the repo's 382 tracked .py files (~59k lines, about half the Python)
# live under these paths. Marking them keeps them out of GitHub's language
# stats, collapses them by default in diffs and PR reviews, and gives any
# tool (linters, dead-code scans, duplication detectors, LOC counts) one
# place to learn what to skip. Duplicate filenames and identical bodies
# across these directories are expected, not a defect.
#
# See docs/GENERATED_CODE.md.

src/LLMVersion/*_eval/**            linguist-generated=true
src/LLMVersion/merged_eval_*/**     linguist-generated=true
**/snapshots/**                     linguist-generated=true
**/distilled_rules.py               linguist-generated=true
