{
  "name": "v6_6-2-2",
  "_about": "Base parser vs the original distillation algorithm vs the unit algorithm (two teachers), all trained on the same train papers of the v6 silver, validated on the same val papers, scored on the same test papers. Split sizes are per category (20 categories x 10 papers).",
  "split": {
    "train": 6,
    "val": 2,
    "test": 2
  },
  "silver_dir": "corpus/silver/opus-5.5__v6",
  "eval_splits": [
    "train",
    "val",
    "test"
  ],
  "trajectory_splits": [
    "val",
    "test"
  ],
  "arms": {
    "base": {
      "alg": "none"
    },
    "v51_released": {
      "alg": "fixed",
      "rules_dir": "extractors/rules/silver_v5.1__subset_selection__2026-08",
      "note": "reference only: trained on v5.1 labels (its training papers are all in this split's train)"
    },
    "units_haiku_fdr10": {
      "alg": "units",
      "model": "claude-haiku-5-5",
      "args": {
        "accept": "fdr",
        "fdr-scope": "rule",
        "max-fdr": 0.1,
        "max-llm-calls": 5000
      }
    },
    "units_haiku_fdr25": {
      "alg": "units",
      "model": "claude-haiku-5-5",
      "args": {
        "accept": "fdr",
        "fdr-scope": "rule",
        "max-fdr": 0.25,
        "max-llm-calls": 5000
      }
    },
    "units_haiku_f1": {
      "alg": "units",
      "model": "claude-haiku-5-5",
      "args": {
        "accept": "f1",
        "max-llm-calls": 5000
      }
    },
    "units_sonnet": {
      "alg": "units",
      "model": "claude-sonnet-5-5",
      "args": {
        "accept": "f1",
        "effort": "low",
        "max-examples": 60,
        "max-llm-calls": 2500,
        "train-metric": "m1g"
      },
      "note": "cost levers: effort low (thinking is ~80% of cost), at most 60 examples per proposal; drop them for a full-cost run"
    },
    "units_haiku_f1_train40": {
      "alg": "units",
      "model": "claude-haiku-5-5",
      "args": {
        "accept": "f1",
        "max-llm-calls": 5000
      },
      "train_per_category": 2
    },
    "units_haiku_f1_train80": {
      "alg": "units",
      "model": "claude-haiku-5-5",
      "args": {
        "accept": "f1",
        "max-llm-calls": 5000
      },
      "train_per_category": 4
    },
    "units_haiku_f1_rep2": {
      "alg": "units",
      "model": "claude-haiku-5-5",
      "args": {
        "accept": "f1",
        "max-llm-calls": 5000
      },
      "note": "repeat of units_haiku_f1 (run-to-run spread)"
    },
    "units_haiku_f1_rep3": {
      "alg": "units",
      "model": "claude-haiku-5-5",
      "args": {
        "accept": "f1",
        "max-llm-calls": 5000
      },
      "note": "repeat of units_haiku_f1 (run-to-run spread)"
    },
    "old_haiku_train40": {
      "alg": "merged",
      "model": "claude-haiku-5-5",
      "train_per_category": 2,
      "args": {
        "score-every": 0,
        "order": "worst-first"
      },
      "note": "Yaron's algorithm (analyze, aggregate, FDR prune; all rules kept, no subset selection) on the same 40 papers as units_haiku_f1_train40"
    },
    "g_units_haiku_f1": {
      "alg": "units",
      "model": "claude-haiku-5-5",
      "args": {
        "accept": "f1",
        "train-metric": "m1g",
        "max-llm-calls": 5000
      },
      "note": "main result: graded-M1 training, 120 papers"
    },
    "g_units_haiku_f1_rep2": {
      "alg": "units",
      "model": "claude-haiku-5-5",
      "args": {
        "accept": "f1",
        "train-metric": "m1g",
        "max-llm-calls": 5000
      },
      "note": "repeat of g_units_haiku_f1"
    },
    "g_units_haiku_f1_rep3": {
      "alg": "units",
      "model": "claude-haiku-5-5",
      "args": {
        "accept": "f1",
        "train-metric": "m1g",
        "max-llm-calls": 5000
      },
      "note": "repeat of g_units_haiku_f1"
    },
    "g_units_haiku_f1_train40": {
      "alg": "units",
      "model": "claude-haiku-5-5",
      "args": {
        "accept": "f1",
        "train-metric": "m1g",
        "max-llm-calls": 5000
      },
      "train_per_category": 2,
      "note": "40 training papers (same as old_haiku_train40)"
    },
    "g_units_haiku_f1_train80": {
      "alg": "units",
      "model": "claude-haiku-5-5",
      "args": {
        "accept": "f1",
        "train-metric": "m1g",
        "max-llm-calls": 5000
      },
      "train_per_category": 4,
      "note": "80 training papers"
    }
  },
  "metrics": [
    "m1g",
    "m1",
    "m3"
  ]
}